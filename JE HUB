--// 3. FUNCIONES DEL HUB (EJEMPLOS CLAVE)
--// ==========================================

-- Función: Super Velocidad (WalkSpeed)
local speedActive = false
createFeatureButton("⚡ Alternar Super Velocidad (WalkSpeed)", function()
	speedActive = not speedActive
	local char = player.Character
	if char and char:FindFirstChild("Humanoid") then
		if speedActive then
			char.Humanoid.WalkSpeed = 60
			print("Super Velocidad Activada")
		else
			char.Humanoid.WalkSpeed = 16
			print("Super Velocidad Desactivada")
		end
	end
end)

-- Función: Super Salto (JumpPower)
local jumpActive = false
createFeatureButton("🦘 Alternar Super Salto (JumpPower)", function()
	jumpActive = not jumpActive
	local char = player.Character
	if char and char:FindFirstChild("Humanoid") then
		char.Humanoid.UseJumpPower = true
		if jumpActive then
			char.Humanoid.JumpPower = 120
		else
			char.Humanoid.JumpPower = 50
		end
	end
end)

-- Función: Noclip (Atravesar paredes)
local noclipConnection = nil
local noclipActive = false
createFeatureButton("👻 Alternar Noclip (Atravesar paredes)", function()
	noclipActive = not noclipActive
	if noclipActive then
		noclipConnection = RunService.Stepped:Connect(function()
			local char = player.Character
			if char then
				for _, part in pairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end
		end)
		print("Noclip Activado")
	else
		if noclipConnection then
			noclipConnection:Disconnect()
			noclipConnection = nil
		end
		print("Noclip Desactivado")
	end
end)

-- Función: Resetear personaje
createFeatureButton("💀 Resetear Personaje", function()
	local char = player.Character
	if char and char:FindFirstChild("Humanoid") then
		char.Humanoid.Health = 0
	end
end)

--// 4. Sistema para poder arrastrar la ventana (Draggable)
local dragging, dragInput, dragStart, startPos

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

RunService.RenderStepped:Connect(function()
	if dragging and dragInput then
		local delta = dragInput.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)
