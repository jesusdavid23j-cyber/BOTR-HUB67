-- // 1. SISTEMA DE VELOCIDAD (16 - 100) // --
SpeedBox.FocusLost = function(enterPressed)
    local val = tonumber(SpeedBox.Text)
    if val then
        if val < 16 then val = 16 end
        if val > 100 then val = 100 end
        getgenv().SantanaHub.WalkSpeed = val
        SpeedBox.Text = tostring(val)
        if getgenv().SantanaHub.SpeedEnabled then
            SpeedBtn.Text = "Speed: " .. val .. " (ON)"
        end
    else
        SpeedBox.Text = tostring(getgenv().SantanaHub.WalkSpeed)
    end
end

SpeedBtn.MouseButton1Click:Connect(function()
    getgenv().SantanaHub.SpeedEnabled = not getgenv().SantanaHub.SpeedEnabled
    if getgenv().SantanaHub.SpeedEnabled then
        SpeedBtn.Text = "Speed: " .. getgenv().SantanaHub.WalkSpeed .. " (ON)"
        SpeedBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
        SpeedBtn.Text = "Speed: " .. getgenv().SantanaHub.WalkSpeed .. " (OFF)"
        SpeedBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = 16
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if getgenv().SantanaHub.SpeedEnabled then
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = getgenv().SantanaHub.WalkSpeed
            end
        end)
    end
end)

-- // 2. SISTEMA DE AIMBOT // --
local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                if onScreen then
                    local magnitude = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                    if magnitude < shortestDistance then
                        shortestDistance = magnitude
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

AimbotBtn.MouseButton1Click:Connect(function()
    getgenv().SantanaHub.AimbotEnabled = not getgenv().SantanaHub.AimbotEnabled
    if getgenv().SantanaHub.AimbotEnabled then
        AimbotBtn.Text = "Aimbot (ON)"
        AimbotBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
